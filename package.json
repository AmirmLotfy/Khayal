{
  "name": "khayal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "start": "vite preview --host localhost --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "assets:vision": "node scripts/fetch-vision-assets.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs",
    "submission:frames": "node --experimental-strip-types scripts/export-stage-frames.ts && node scripts/rasterize-stage-previews.mjs",
    "submission:captions": "node scripts/prepare-captions.mjs",
    "submission:review": "node scripts/render-review.mjs",
    "submission:check": "node scripts/prepare-video.mjs --check",
    "rehearse": "node scripts/rehearse-show.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "5.0.5"
  }
}
